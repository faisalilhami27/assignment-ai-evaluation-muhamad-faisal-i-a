# Salin file ini menjadi .env lalu isi dengan API key milik Anda sendiri.
# JANGAN commit file .env ke repository (sudah tercantum di .gitignore).

# Wajib — API key Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model utama (Gemini 3.8 Flash) & Model Fallback (bila model utama overload/503)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Parameter RAG
RAG_TOP_K=3
RAG_MIN_SCORE=0.7

# Observability — LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ai-evaluation-it-helpdesk
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Ekspos metrik latency/token per-request di field `meta` (HANYA untuk evaluasi)
EVAL_EXPOSE_METRICS=false
